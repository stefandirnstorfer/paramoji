doctype html
mixin try-it
  p(style="text-align:center")
    a.button7(href='editor.html' style="background-color:coral")
      span(style="border-right:1px solid rgba(255,255,255,0.5); padding-right:0.3em; margin-right:0.3em;") &#x270E;
      | Try it out
mixin clickable-face(param, name)
  -var facelink='https://paramoji.org/paramoji.svg.php?' + param
  -var editlink='editor.html?' + param
  div
    .table-head=name
    a(href=editlink)
      .onhover(style="text-align:center;height:100px")
        img(src=facelink, height=100, width=100 alt=name)

html(lang="en")
  head
    title Paramoji
    link(rel="canonical" href="https://paramoji.org")
    link(rel='stylesheet' href='style.css')
    link(rel="icon" href="https://paramoji.org/paramoji.svg.php?v=100&a1=100&a2=100&d=50&c=0&dark=1" media="(prefers-color-scheme: dark)")
    link(rel="icon" href="https://paramoji.org/paramoji.svg.php?v=100&a1=100&a2=100&d=50&c=0&dark=0" media="(prefers-color-scheme: light)")
    link(rel="icon" href="https://paramoji.org/paramoji.svg.php?v=100&a1=100&a2=100&d=50&c=0")
    meta(charset="utf-8")
    meta(property="og:image" content="https://paramoji.org/images/encode2.png")
    meta(property="og:image:width" content="879")
    meta(property="og:image:height" content="581")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content="A parametric emoji that can be parameterized with six continuous dimensions. It visualizes and unifies dimensional and categorical emotional models.")
  body.page
    .twocol(style="text-align:center")
      h1.title Paramoji
    div
      h1#what-is-a-paramoji What is a paramoji?
      p
        | A paramoji is a parametric icon that represents facial expressions on continuous scales.
        | They are similar to Emojis, but instead of being enumerated they are parametric.
        | The expressions are rendered from parameters that can be freely selected on a continous scale.
        | They can be used to visualize manually selected, automatically detected or
        | computationally generated data with accuracy and with arbitrary nuances.
        | The resulting emoji style icons are expressive, exaggerated and playful. Their emotional content
        | can be easily recognized by humans.
        p Read more about the design principles of paramojis:
          |  <a href="https://osf.io/preprints/psyarxiv/6etdx">Visualizing emotions with linearly parameterized facial expressions</a>

    div(style="text-align:center")
      a(href='editor.html?v=72&a1=98&a2=36')
        img(src="images/encode2.png" style="max-width:500px;width:90%")
      +try-it

    h2.twocol How do Paramojis look?
    .twocol
       p
          | Paramojis are designed to look clear and minimalistic. They work on various scales, as well as light and dark backgrounds.
          | They are informative, simple and fit into a range of designs.
    div.videos.twocol
      a(href="images/info.png")
        img(src="images/info.png" alt="Paramojis used in an info graphics")
      a(href="images/info-bw.png")
        img(src="images/info-bw.png" style="background-color:white" alt="Paramojis in a black and white info graphics")
      a(href="images/checkers.svg")
        img(src="images/checkers.png" alt="Paramojis on a checkerboard")
      a(href="images/fraktal.jpg")
        img(src="images/fraktal-small.jpg" alt="Paramojis fractal with various scales")

