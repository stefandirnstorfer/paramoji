extends layout

block head
  script(src="./lib/vue.global.js")
  script(src="action.js" type="module")

block nav
  +nav('home')

block content
  div
    h1.twocol#what-is-a-paramoji What are paramojis
    p
      | A paramoji is a parametric icon that represents facial expressions on continuous scales.
      | Unlike enumerated emojis, its expression is rendered from parameters chosen freely on continuous axes,
      | so it can visualize measured, detected or computationally generated emotional data with arbitrary nuance.
      | The resulting icons are expressive, exaggerated and playful, and their emotional content is easily recognized by humans.

  #app.paramoji-home
    .space(:class="{copied}" v-html="copied ? 'Copied' : paramoji()")
    .home-buttons
      button(@click="changeFace()") Change
      button.copy(@click="copyUrl()" aria-label="Copy image URL") &#x1F4CB;
      a.pencil(:href="editorLink()" aria-label="Open in the editor") &#x270E;

  h2.twocol Explore
  .cards.twocol
    a.card(href="gallery.html")
      h3 Gallery
      p Static and animated examples of paramojis in infographics, videos and designs.
    a.card(href="api.html")
      h3 API
      p Embed paramojis with a simple image URL and the full parameter reference.
    a.card(href="about.html")
      h3 About
      p Who uses paramojis, related research, and contact.
